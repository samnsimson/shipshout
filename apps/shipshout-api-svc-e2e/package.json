{
    "name": "@shipshout/shipshout-api-svc-e2e",
    "version": "0.0.1",
    "private": true,
    "nx": {
        "implicitDependencies": [
            "@shipshout/shipshout-api-svc"
        ],
        "targets": {
            "e2e": {
                "executor": "@nx/jest:jest",
                "outputs": [
                    "{projectRoot}/test-output/jest/coverage"
                ],
                "dependsOn": [
                    "@shipshout/shipshout-api-svc:build",
                    "@shipshout/shipshout-api-svc:serve"
                ],
                "options": {
                    "jestConfig": "apps/shipshout-api-svc-e2e/jest.config.cts",
                    "passWithNoTests": true
                }
            }
        },
        "name": "@shipshout/shipshout-api-svc-e2e"
    }
}
