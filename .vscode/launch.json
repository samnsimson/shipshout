{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug @shipshout/shipshout-svc with Nx",
            "runtimeExecutable": "bun",
            "runtimeArgs": ["nx", "serve", "@shipshout/shipshout-svc"],
            "env": {
                "NODE_OPTIONS": "--inspect=9229"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"],
            "sourceMaps": true,
            "outFiles": ["${workspaceFolder}/apps/shipshout-svc/dist/**/*.(m|c|)js", "!**/node_modules/**"]
        }
    ]
}
