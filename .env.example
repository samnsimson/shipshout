DATABASE_URL=
REDIS_URL=
PORT=8000
BETTER_AUTH_BASE_URL=http://localhost:8000
BETTER_AUTH_SECRET=
SHIPSHOUT_API_URL=http://localhost:8000
NEXT_PUBLIC_SHIPSHOUT_API_URL=http://localhost:8000
CLIENT_APP_URL=http://localhost:3000
# Optional: shared cookie domain for production (e.g. .shipshout.com)
AUTH_COOKIE_DOMAIN=
RESEND_API_KEY=
# Verified sender in Resend; local testing can use onboarding@resend.dev
EMAIL_FROM=Shipshout <onboarding@resend.dev>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: separate GitHub OAuth app for repository linking (recommended; OAuth apps allow only one callback URL)
GITHUB_REPO_CLIENT_ID=
GITHUB_REPO_CLIENT_SECRET=
# Optional override; defaults to {BETTER_AUTH_BASE_URL}/repositories/github/callback
GITHUB_REPO_OAUTH_CALLBACK_URL=
# Public API base URL for GitHub webhook callbacks (must be reachable by GitHub — not localhost).
# Local dev: run ngrok http 8000 and set this to the ngrok HTTPS URL.
# Defaults to BETTER_AUTH_BASE_URL when unset.
API_BASE_URL=
# Encrypts stored GitHub webhook secrets (defaults to BETTER_AUTH_SECRET)
WEBHOOK_SECRET_ENCRYPTION_KEY=
# Stripe (Better Auth plugin + Nest invoice reads). Copy test keys from shipshout_back locally; never commit secrets.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
