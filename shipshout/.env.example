DATABASE_URL=postgres://shipshout:shipshout@localhost:5434/shipshout
REDIS_URL=redis://localhost:6380
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=
SESSION_SECRET=
# Platform auth emails (verify + password reset) — separate from workspace Resend keys
RESEND_API_KEY=
AUTH_EMAIL_FROM=ShipShout <auth@yourdomain.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
# GitHub App (recommended) — automatic webhooks via App install flow.
# Required repository permissions (set once in GitHub App → Permissions & events):
#   Metadata: Read-only
#   Administration: Read and write  (registers release webhooks on connect)
# App-level webhook (General tab) still needed for delivery URL + secret:
#   URL: {API_BASE_URL}/api/webhooks/github
#   Secret: same as GITHUB_APP_WEBHOOK_SECRET below
# Setup URL: {API_BASE_URL}/api/github/install/callback
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=
WEB_BASE_URL=http://localhost:4200
API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Stripe (test mode) — from Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_GROWTH=

X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
MAILCHIMP_CLIENT_ID=
MAILCHIMP_CLIENT_SECRET=
EMAIL_FROM=updates@yourdomain.com
