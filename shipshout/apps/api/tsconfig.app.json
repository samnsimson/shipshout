{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist",
        "types": ["node"],
        "rootDir": "src",
        "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "isolatedModules": false,
        "target": "es2021"
    },
    "include": ["src/**/*.ts"],
    "references": [
        {
            "path": "../../../libs/database/tsconfig.lib.json"
        },
        {
            "path": "../../../libs/auth/tsconfig.lib.json"
        }
    ],
    "exclude": ["out-tsc", "dist", "jest.config.ts", "jest.config.cts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
