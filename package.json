{
    "name": "@shipshout/source",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "format": "prettier --write '**/*.{ts,js,json,md}'",
        "generate": "bun ./scripts/generate.script.ts",
        "migration:generate": "bunx --bun typeorm migration:generate ./libs/database/src/lib/migrations/Migration -d ./typeorm.config.ts",
        "migration:run": "bunx --bun typeorm migration:run -d ./typeorm.config.ts",
        "migration:revert": "bunx --bun typeorm migration:revert -d ./typeorm.config.ts",
        "dev": "nx run-many --target=serve --projects=tag:type:app --output-style=stream"
    },
    "private": true,
    "dependencies": {
        "@nestjs/axios": "^4.0.1",
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@nestjs/swagger": "^11.4.6",
        "@nestjs/terminus": "^11.1.1",
        "@nestjs/typeorm": "^11.0.3",
        "@thallesp/nestjs-better-auth": "^2.7.0",
        "@types/bun": "^1.3.14",
        "@types/express": "^5.0.6",
        "axios": "^1.19.0",
        "better-auth": "^1.6.26",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "express": "^5.2.1",
        "inquirer": "^14.0.2",
        "nest-winston": "^1.10.2",
        "pg": "^8.22.0",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.0",
        "typeorm": "^1.1.0",
        "winston": "^3.19.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.8.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.0",
        "@nx/docker": "23.1.1",
        "@nx/eslint": "23.1.1",
        "@nx/eslint-plugin": "23.1.1",
        "@nx/jest": "23.1.1",
        "@nx/js": "23.1.1",
        "@nx/nest": "23.1.1",
        "@nx/node": "23.1.1",
        "@nx/web": "23.1.1",
        "@nx/webpack": "23.1.1",
        "@nx/workspace": "23.1.1",
        "@swc/core": "~1.15.5",
        "@swc/helpers": "~0.5.18",
        "@swc/jest": "~0.2.38",
        "@types/jest": "~30.0.0",
        "@types/node": "^22.0.0",
        "eslint": "^9.8.0",
