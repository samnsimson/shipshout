        "jest-environment-node": "~30.3.0",
        "jest-util": "~30.3.0",
        "jsonc-eslint-parser": "^2.1.0",
        "nx": "23.1.1",
        "prettier": "~3.6.2",
        "ts-jest": "^29.4.7",
        "ts-node": "10.9.1",
        "tslib": "^2.3.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.58.0",
        "webpack": "^5.101.3",
        "webpack-cli": "^7.0.0",
